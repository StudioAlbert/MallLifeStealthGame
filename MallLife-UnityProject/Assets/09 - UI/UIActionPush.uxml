<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/09%20-%20UI/Style.uss?fileID=7433441132597879392&amp;guid=a5ddd88d4ee62284286cba5298daf885&amp;type=3#Style"/>
    <ui:VisualElement name="Root" class="qte-root" style="flex-grow: 0; align-items: auto; justify-content: flex-start; font-size: 28px; position: relative; -unity-font-style: bold; width: 100%; height: 100%; transform-origin: center; align-content: auto; flex-shrink: 0; border-left-color: rgba(200, 200, 200, 0); border-right-color: rgba(200, 200, 200, 0); border-top-color: rgba(200, 200, 200, 0); border-bottom-color: rgba(200, 200, 200, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; translate: 0 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0);">
        <ui:VisualElement name="Panel" class="qte-panel">
            <ui:Label text="This a cube" name="Title" class="basic-text-prompt"/>
            <ui:VisualElement name="Content" class="qte-content" style="flex-grow: 1; margin-top: 5px; margin-bottom: 5px;">
                <ui:VisualElement name="StartPanel" style="flex-grow: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(248, 248, 248); border-left-color: rgb(248, 248, 248); border-right-color: rgb(248, 248, 248); border-bottom-color: rgb(248, 248, 248); display: none; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; height: 40px; align-content: center; margin-top: 0; margin-bottom: 0; top: auto; justify-content: center;">
                    <ui:Label text="Press A to steal" class="basic-text-prompt" style="top: auto; bottom: auto; align-content: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement name="ActivePanel" style="flex-grow: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(248, 248, 248); border-left-color: rgb(248, 248, 248); border-right-color: rgb(248, 248, 248); border-bottom-color: rgb(248, 248, 248); align-content: center; justify-content: center; height: 75px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; flex-shrink: 0;">
                    <ui:Label text="Quick Push A to Steal" class="basic-text-prompt" style="margin-top: 0; margin-bottom: 5px;"/>
                    <ui:VisualElement name="TotalTimeBar" style="flex-grow: 0; height: 10px; background-color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 5px; margin-right: 0; margin-bottom: 5px; margin-left: 0; display: flex;"/>
                </ui:VisualElement>
                <ui:VisualElement name="SuccesPanel" style="flex-grow: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(145, 231, 165); border-left-color: rgb(145, 231, 165); border-right-color: rgb(145, 231, 165); border-bottom-color: rgb(145, 231, 165); display: flex; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; background-color: rgb(76, 120, 86); flex-shrink: 0; height: 25px; align-content: center; justify-content: center;">
                    <ui:Label text="Success" class="basic-text-prompt" style="color: rgb(145, 231, 165);"/>
                </ui:VisualElement>
                <ui:VisualElement name="FailedPanel" style="flex-grow: 1; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(235, 111, 76); border-left-color: rgb(235, 111, 76); border-right-color: rgb(235, 111, 76); border-bottom-color: rgb(235, 111, 76); display: flex; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; background-color: rgb(135, 57, 29); height: 25px; align-content: center;">
                    <ui:Label text="Failed" class="basic-text-prompt" style="color: rgb(224, 113, 81);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
