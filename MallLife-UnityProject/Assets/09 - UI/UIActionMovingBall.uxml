<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/09%20-%20UI/Style.uss?fileID=7433441132597879392&amp;guid=a5ddd88d4ee62284286cba5298daf885&amp;type=3#Style"/>
    <ui:VisualElement name="Root" style="flex-grow: 0; align-items: center; justify-content: flex-end; position: relative; width: 100%; height: 100%; transform-origin: center; align-content: auto; flex-shrink: 0; border-left-color: rgba(200, 200, 200, 0); border-right-color: rgba(200, 200, 200, 0); border-top-color: rgba(200, 200, 200, 0); border-bottom-color: rgba(200, 200, 200, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; translate: 0 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0);">
        <ui:VisualElement name="Panel" class="qte-panel" style="flex-grow: 1; border-top-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; width: 60%; height: auto; flex-shrink: 1; position: absolute; background-color: rgba(64, 75, 77, 0.28); transform-origin: center; translate: 0 0; justify-content: flex-start; align-content: auto; bottom: 10%;">
            <ui:Label text="This a cube" name="Title" class="basic-text-prompt" style="font-size: 24px; border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
            <ui:VisualElement name="Content" style="flex-grow: 1; margin-top: 5px; margin-bottom: 5px;">
                <ui:VisualElement name="StartPanel">
                    <ui:Label text="Press A to steal" class="basic-text-prompt" style="top: auto; bottom: auto; align-content: auto; font-size: 24px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="ActivePanel" style="flex-grow: 0; align-content: center; justify-content: center; height: auto; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; flex-shrink: 0;">
                    <ui:Label text="Maintain A" class="basic-text-prompt" style="margin-top: 0; margin-bottom: 5px;"/>
                    <ui:VisualElement name="ProgressBar" style="flex-grow: 0; height: 30px; background-color: rgba(230, 25, 25, 0.27); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 5px; margin-right: 0; margin-bottom: 5px; margin-left: 0; display: flex; justify-content: center; align-items: center; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
                        <ui:VisualElement name="GreenZone" style="flex-grow: 0; background-size: auto auto; flex-shrink: 0; position: absolute; background-color: rgb(117, 240, 49); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 2px; border-bottom-width: 0; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; width: 15%; height: 100%; justify-content: space-between; translate: 0% 0; left: auto; right: auto; align-self: auto; align-content: auto; align-items: center;"/>
                        <ui:VisualElement name="YellowZone" style="flex-grow: 0; background-size: auto auto; flex-shrink: 0; position: absolute; background-color: rgba(230, 184, 26, 0.5); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 2px; border-bottom-width: 0; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; width: 35%; height: 100%; justify-content: space-between; translate: 0% 0; left: auto; right: auto; align-self: auto;"/>
                        <ui:VisualElement name="MovingBall" style="flex-grow: 0; background-size: auto auto; flex-shrink: 0; position: absolute; background-color: rgba(0, 0, 0, 0.5); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; width: auto; height: 100%; justify-content: space-between; translate: 0 0; aspect-ratio: 1; align-self: flex-start;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MaintainBar" style="flex-grow: 0; height: 10px; background-color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 5px; margin-right: 0; margin-bottom: 5px; margin-left: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="SuccesPanel" style="flex-grow: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(145, 231, 165); border-left-color: rgb(145, 231, 165); border-right-color: rgb(145, 231, 165); border-bottom-color: rgb(145, 231, 165); display: flex; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; background-color: rgb(76, 120, 86); flex-shrink: 0; height: auto; align-content: center; justify-content: center;">
                    <ui:Label text="Success" class="basic-text-prompt" style="color: rgb(145, 231, 165);"/>
                </ui:VisualElement>
                <ui:VisualElement name="FailedPanel" style="flex-grow: 1; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(235, 111, 76); border-left-color: rgb(235, 111, 76); border-right-color: rgb(235, 111, 76); border-bottom-color: rgb(235, 111, 76); display: flex; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; background-color: rgb(135, 57, 29); height: auto; align-content: center;">
                    <ui:Label text="Failed" class="basic-text-prompt" style="color: rgb(224, 113, 81);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
