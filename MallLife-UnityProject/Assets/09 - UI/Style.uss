:root {
}

.basic-text-prompt {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-grow: 0;
    flex-shrink: 1;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 12px;
}

.action-buttom {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    height: 25px;
}

.slot-icon {
    flex-grow: 1;
    position: relative;
    margin-top: 11%;
    margin-right: 11%;
    margin-bottom: 11%;
    margin-left: 11%;
    left: auto;
    right: auto;
    bottom: auto;
    top: auto;
    align-self: center;
    align-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    flex-shrink: 1;
    overflow: visible;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    aspect-ratio: 1;
}

.slot-container {
    flex-grow: 0;
    width: 13%;
    height: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    min-width: auto;
    min-height: auto;
    flex-shrink: 0;
    aspect-ratio: 1;
    flex-basis: auto;
    justify-content: flex-start;
    align-items: auto;
    align-self: auto;
    align-content: auto;
}
