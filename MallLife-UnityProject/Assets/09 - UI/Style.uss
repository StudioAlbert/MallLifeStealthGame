:root {
}

.basic-text-prompt {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-grow: 0;
    flex-shrink: 1;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 24px;
    -unity-font-style: bold;
}

.action-buttom {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
    height: 25px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 28px;
}

.slot-icon {
    flex-grow: 1;
    position: relative;
    margin-top: 11%;
    margin-right: 11%;
    margin-bottom: 11%;
    margin-left: 11%;
    left: auto;
    right: auto;
    bottom: auto;
    top: auto;
    align-self: center;
    align-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    flex-shrink: 1;
    overflow: visible;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    aspect-ratio: 1;
}

.slot-container {
    flex-grow: 0;
    width: 13%;
    height: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    min-width: auto;
    min-height: auto;
    flex-shrink: 0;
    aspect-ratio: 1;
    flex-basis: auto;
    justify-content: flex-start;
    align-items: auto;
    align-self: auto;
    align-content: auto;
}

.root-menu {
    flex-grow: 1;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 8%;
    padding-right: 8%;
    padding-bottom: 8%;
    padding-left: 8%;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.qte-panel {
    background-color: rgb(85, 85, 85);
}
